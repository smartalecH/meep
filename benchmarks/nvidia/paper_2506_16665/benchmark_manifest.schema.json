{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meep.readthedocs.io/schemas/nvidia-paper-benchmark-manifest-v4.json",
  "title": "Meep NVIDIA paper benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_schema", "generator", "reference", "case_definitions", "result_schema", "input_checkout", "case", "excitation", "discretization", "materials", "execution", "stopping", "validation_policy", "paper_comparison", "adaptations"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "backend", "precision", "ranks", "mpi_transport", "overlap", "graph"],
      "properties": {
        "mode": {"enum": ["smoke", "fixed-step", "end-to-end"]},
        "backend": {"enum": ["auto", "cpu", "nvidia"]},
        "precision": {"enum": ["native", "f32", "mixed"]},
        "ranks": {"type": "integer", "minimum": 1},
        "mpi_transport": {"enum": ["none", "host", "staged", "direct", "auto"]},
        "overlap": {"enum": ["off", "auto", "required"]},
        "graph": {"enum": ["eager", "auto", "required"]}
      }
    },
    "monitor": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1},
        "observable": {"type": "string", "minLength": 1}
      }
    },
    "requiredObservable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "monitor", "unit", "evaluation", "absolute_tolerance", "relative_tolerance"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "monitor": {"$ref": "#/$defs/monitor"},
        "unit": {"type": "string", "minLength": 1},
        "evaluation": {"enum": ["linear_center_wavelength_mode_power_ratio", "negative_ten_log10_linear_center_wavelength_mode_power_ratio", "not_a_knot_cubic_spline_1000_half_depth"]},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 4},
    "manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 4}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "generated_at_utc"],
      "properties": {
        "name": {"const": "paper_2506_16665.benchmark_manifest"},
        "version": {"const": 4},
        "generated_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*\\+00:00$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "paper"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "paper": {"type": "object"}
      }
    },
    "case_definitions": {"$ref": "#/$defs/pathHash"},
    "result_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"enum": [1, 2]}
      }
    },
    "input_checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "dirty", "status_porcelain", "gds", "yaml", "layer_stack"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "status_porcelain": {"type": "array", "items": {"type": "string"}},
        "gds": {"$ref": "#/$defs/asset"},
        "yaml": {"$ref": "#/$defs/asset"},
        "layer_stack": {"$ref": "#/$defs/asset"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "dimensions", "paper_domain_um", "geometry_summary", "geometry_import", "layers", "cell", "time_stepping", "boundaries", "ports", "source", "monitors", "decay_stop", "gds_cell_name", "cladding", "top_cladding", "runner_support", "paper_input", "paper_target", "symmetry"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "dimensions": {"const": 3},
        "paper_domain_um": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "geometry_summary": {"type": "string", "minLength": 1},
        "geometry_import": {"type": "object"},
        "layers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "cell": {"type": "object"},
        "time_stepping": {"type": "object"},
        "boundaries": {"type": "object"},
        "ports": {"type": "object"},
        "source": {"type": "object"},
        "monitors": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/monitor"}},
        "decay_stop": {"type": "object"},
        "gds_cell_name": {"type": "string", "minLength": 1},
        "cladding": {"type": "string", "minLength": 1},
        "top_cladding": {"type": ["object", "null"]},
        "runner_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "reason"],
          "properties": {
            "supported": {"type": "boolean"},
            "reason": {"type": ["string", "null"]}
          }
        },
        "paper_input": {"type": "string", "minLength": 1},
        "paper_target": {"type": "string", "minLength": 1},
        "symmetry": {"const": "none"}
      }
    },
    "excitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center_wavelength_um", "bandwidth_nm", "source_wavelength_min_um", "source_wavelength_max_um", "lambda_min_um", "resolution_n_max_wavelength_um", "monitor_sampling"],
      "properties": {
        "center_wavelength_um": {"type": "number", "exclusiveMinimum": 0},
        "bandwidth_nm": {"enum": [20.0, 50.0]},
        "source_wavelength_min_um": {"type": "number", "exclusiveMinimum": 0},
        "source_wavelength_max_um": {"type": "number", "exclusiveMinimum": 0},
        "lambda_min_um": {"type": "number", "exclusiveMinimum": 0},
        "resolution_n_max_wavelength_um": {"type": "number", "exclusiveMinimum": 0},
        "monitor_sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "step_nm", "inclusive_endpoints", "wavelengths_um", "frequencies_meep", "frequency_order", "dft_decimation_factor"],
          "properties": {
            "domain": {"const": "wavelength"},
            "step_nm": {"type": "number", "exclusiveMinimum": 0},
            "inclusive_endpoints": {"const": true},
            "wavelengths_um": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
            "frequencies_meep": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
            "frequency_order": {"const": "decreasing_with_increasing_wavelength"},
            "dft_decimation_factor": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "discretization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells_per_material_wavelength", "n_max", "lambda_min_um", "exact_resolution_px_per_um", "rounding", "resolution_px_per_um", "dx_um"],
      "properties": {
        "cells_per_material_wavelength": {"enum": [6, 10, 15, 20, 25]},
        "n_max": {"type": "number", "exclusiveMinimum": 0},
        "lambda_min_um": {"type": "number", "exclusiveMinimum": 0},
        "exact_resolution_px_per_um": {"type": "number", "exclusiveMinimum": 0},
        "rounding": {"enum": ["ceil", "nearest", "floor", "none"]},
        "resolution_px_per_um": {"type": "number", "exclusiveMinimum": 0},
        "dx_um": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "paper_parameters", "validation", "performance_adaptation", "caveat"],
      "properties": {
        "mode": {"enum": ["paper", "performance-adaptation"]},
        "paper_parameters": {"type": ["object", "null"]},
        "validation": {"type": ["object", "null"]},
        "performance_adaptation": {"type": ["object", "null"]},
        "caveat": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "resolution_required_at_runtime", "requested_gpus", "warmup_steps", "measured_repetitions"],
      "properties": {
        "requested": {"$ref": "#/$defs/execution"},
        "resolution_required_at_runtime": {"type": "boolean"},
        "requested_gpus": {"type": "integer", "minimum": 0},
        "warmup_steps": {"type": "integer", "minimum": 0},
        "measured_repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "stopping": {"type": "object"},
    "validation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "reference", "required_observables"],
      "properties": {
        "schema_version": {"const": 1},
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifact_schema_version", "physics_configuration_sha256", "required_bindings"],
          "properties": {
            "kind": {"const": "cpu_native_baseline"},
            "artifact_schema_version": {"const": 1},
            "physics_configuration_sha256": {"$ref": "#/$defs/sha256"},
            "required_bindings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}
          }
        },
        "required_observables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requiredObservable"}}
      }
    },
    "paper_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing_row", "workload_25", "paper_results", "wall_time_is_stretch_goal"],
      "properties": {
        "timing_row": {"type": "object"},
        "workload_25": {"type": "object"},
        "paper_results": {"type": "object"},
        "wall_time_is_stretch_goal": {"const": true}
      }
    },
    "adaptations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}}
  }
}
